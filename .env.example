# Copy to .env for local runs; in Coolify set these as environment variables.
GOOGLE_SERVICE_ACCOUNT_B64=            # base64 of the service account key JSON, one line
DRIVE_ROOT_ID=0AFIgRksacladUk9PVA      # shared drive root
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BASE_URL=https://creative-factory.example.com   # public URL; the OAuth redirect is BASE_URL/auth/callback
ALLOWED_DOMAIN=appodeal.com
SESSION_SECRET=                        # long random string, e.g. python3 -c "import secrets;print(secrets.token_hex(32))"
DATA_DIR=/data                         # persistent volume: registry cache and job history
# Local development only (skips Google sign-in; never set together with the OAuth variables):
# DEV_USER=you@appodeal.com
