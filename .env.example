# Copy to .env for local runs; in Coolify set these as environment variables.
GOOGLE_SERVICE_ACCOUNT_B64=            # base64 of the service account key JSON, one line
DRIVE_ROOT_ID=0AFIgRksacladUk9PVA      # shared drive root
ELEVENLABS_API_KEY=                   # needs text-to-speech, voices read and music generation permissions
PLANNER_RUNTIME_ARN=                  # AI suggestions via the team's creative-factory-planner agent (AWS Bedrock, no Anthropic key)
AWS_REGION=us-east-1                  # plus AWS credentials allowed to bedrock-agentcore:InvokeAgentRuntime on that ARN
AWS_ACCESS_KEY_ID=                    # issued by DevOps, scoped to the planner runtime only
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=                       # alternative: direct OpenAI call (used when PLANNER_RUNTIME_ARN is empty)
ANTHROPIC_API_KEY=                    # alternative: direct Claude call
# ANALYSIS_PROVIDER=agentcore         # optional: force agentcore, openai or anthropic when several are set
# ANALYSIS_MODEL=gpt-4o               # optional model override for the direct providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BASE_URL=https://creative-factory.example.com   # public URL; the OAuth redirect is BASE_URL/auth/callback
ALLOWED_DOMAIN=appodeal.com
SESSION_SECRET=                        # long random string, e.g. python3 -c "import secrets;print(secrets.token_hex(32))"
DATA_DIR=/data                         # persistent volume: registry cache and job history
# Local development only (skips Google sign-in; never set together with the OAuth variables):
# DEV_USER=you@appodeal.com
